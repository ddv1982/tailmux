#!/usr/bin/env bash
set -uo pipefail
export LC_ALL=C
readonly TAILMUX_VERSION=0.2.3

usage() {
  printf '%s\n' "tailmux $TAILMUX_VERSION" \
    'Usage: tailmux [user@]selector' '       tailmux doctor [[user@]selector]' \
    '       tailmux --config show | set socket PATH | reset socket' \
    '       tailmux --help | --version' \
    'Selectors are known canonical peer names, advertised addresses, or declarative host aliases.' \
    'Set TAILMUX_TAILSCALE_SOCKET to an absolute socket path to select a daemon.' \
    'Only tailscale ssh is supported. No extra options or remote commands are accepted.'
}
report_failure() {
  local category=$1 line=$2 dsn=${TAILMUX_SENTRY_DSN:-} endpoint event_id environment release
  [[ "${mode:-}" != config ]] || return 0
  # Report only fixed categories, never the diagnostic text or request data.
  case "$category" in
    missing-dependency|daemon-unavailable|invalid-schema|local-io) ;;
    *) return 0 ;;
  esac
  local dsn_pattern='^https://[a-fA-F0-9]{32}@([A-Za-z0-9.-]+)/([0-9]+)$'
  [[ "$dsn" =~ $dsn_pattern ]] || return 0
  endpoint="https://${BASH_REMATCH[1]}/api/${BASH_REMATCH[2]}/envelope/"
  command -v curl >/dev/null 2>&1 || return 0
  environment=${TAILMUX_SENTRY_ENVIRONMENT:-production}
  release=${TAILMUX_SENTRY_RELEASE:-tailmux@$TAILMUX_VERSION}
  local environment_pattern='^[A-Za-z0-9_-]{1,64}$' release_pattern='^[A-Za-z0-9@._+-]{1,128}$'
  [[ "$environment" =~ $environment_pattern && "$release" =~ $release_pattern ]] || return 0
  printf -v event_id '%04x%04x%04x%04x%04x%04x%04x%04x' \
    "$RANDOM" "$RANDOM" "$RANDOM" "$RANDOM" "$RANDOM" "$RANDOM" "$RANDOM" "$RANDOM"
  {
    printf '{"event_id":"%s","dsn":"%s"}\n' "$event_id" "$dsn"
    printf '{"type":"event","content_type":"application/json"}\n'
    printf '{"event_id":"%s","platform":"other","level":"error","release":"%s","environment":"%s",' \
      "$event_id" "$release" "$environment"
    printf '"fingerprint":["tailmux","%s"],"tags":{"component":"tailmux-cli","error_category":"%s"},' "$category" "$category"
    printf '"exception":{"values":[{"type":"TailmuxError","value":"%s",' "$category"
    printf '"mechanism":{"type":"tailmux","handled":true},"stacktrace":{"frames":['
    printf '{"filename":"bin/tailmux","function":"main","lineno":%s,"in_app":true}]}}]}}\n' "$line"
  } | curl -qfsS --proto '=https' --connect-timeout 2 --max-time 3 --retry 0 \
    --header 'Content-Type: application/x-sentry-envelope' --data-binary @- "$endpoint" >/dev/null 2>&1 || :
}

fail() {
  printf 'tailmux: %s\n' "$1" >&2
  report_failure "${1%%:*}" "${BASH_LINENO[0]}"
  exit "${2:-1}"
}

socket_value_valid() {
  [[ "$1" == /* && "$1" != *[[:cntrl:]]* ]]
}

config_location() {
  [[ "${HOME:-}" == /* && "$HOME" != / && "$HOME" != */ && "$HOME" != *[[:cntrl:]]* &&
    "$HOME" != *'/../'* && "$HOME" != */.. && "$HOME" != *'/./'* && "$HOME" != */. && "$HOME" != *'//'* ]] ||
    fail 'invalid-config: HOME must be an absolute path without controls, dot components, or trailing slash' 2
  config_dir=$HOME/.config/tailmux
  config_file=$config_dir/config
}

config_metadata() {
  local target=$1 kind=$2 component parent mode uid links size flags extra metadata listing line token previous='' index=0
  local -a paths=("$target")
  [[ ! -L "$target" ]] || return 1
  if [[ "$kind" == file ]]; then [[ -f "$target" && -r "$target" ]] || return 1
  else [[ -d "$target" ]] || return 1; fi
  component=$target
  while [[ "$component" != / ]]; do
    component=${component%/*}
    [[ -n "$component" ]] || component=/
    [[ -d "$component" && ! -L "$component" ]] || return 1
    paths+=("$component")
  done
  case "$OSTYPE" in
    darwin*)
      metadata=$(stat -f '%u %p %l %z %f' "${paths[@]}") || return 1
      listing=$(ls -lde "${paths[@]}") || return 1 ;;
    linux*)
      metadata=$(stat -c '%u %a %h %s 0' "${paths[@]}") || return 1
      listing=$(ls -ld -- "${paths[@]}") || return 1 ;;
    *) return 1 ;;
  esac
  while IFS= read -r line; do
    IFS=' ' read -r uid mode links size flags extra <<< "$line"
    [[ "$uid" =~ ^[0-9]{1,10}$ && "$mode" =~ ^[0-7]{1,8}$ && "$links" =~ ^[0-9]{1,10}$ &&
      "$size" =~ ^[0-9]{1,18}$ && "$flags" =~ ^[0-9]{1,10}$ && -z "$extra" && $index -lt ${#paths[@]} ]] || return 1
    parent=${paths[$index]}
    if [[ $index == 0 && "$kind" == file ]]; then
      [[ "$uid" == "$UID" && "$links" == 1 && "$flags" == 0 ]] && (( (8#$mode & 07777) == 0600 && size <= 8192 )) || return 1
      config_size=$size
    elif [[ "$parent" == "$HOME" || "$parent" == "$HOME/"* ]]; then
      [[ "$uid" == "$UID" ]] && (( (8#$mode & 0022) == 0 )) || return 1
    else
      [[ "$uid" == "$UID" || "$uid" == 0 ]] &&
        (( (8#$mode & 0022) == 0 || (uid == 0 && (8#$mode & 01000) != 0) )) || return 1
    fi
    index=$((index + 1))
  done <<< "$metadata"
  [[ $index == "${#paths[@]}" ]] || return 1
  index=0
  while IFS= read -r line; do
    token=${line%% *}
    # macOS home directories can carry this non-mutating ACL inherited from the OS.
    if [[ "$OSTYPE" == darwin* && "$previous" == d* && "$line" == ' 0: group:everyone deny delete' ]]; then previous=''; continue; fi
    [[ "$token" =~ ^[d-][rwxStTs-]{9}[@.]?$ ]] || {
      [[ "$OSTYPE" == darwin* && "$token" =~ ^d[rwxStTs-]{9}\+$ ]] || return 1
      [[ "$listing" == *$'\n 0: group:everyone deny delete'* ]] || return 1
    }
    previous=$token
    index=$((index + 1))
  done <<< "$listing"
  [[ $index == "${#paths[@]}" ]]
}

config_snapshot() {
  config_text=$(
    head -c 8193 < "$1" | tr '\000' '\001'
    status=$?
    printf '\002'
    exit "$status"
  ) || return 1
  config_text=${config_text%$'\002'}
  [[ ${#config_text} == "$config_size" && ${#config_text} -le 8192 ]]
}

config_read() {
  local record value has_nul=false
  saved_socket=(unsafe '' "unsafe, linked, unreadable, oversized, or unverifiable data at $config_file")
  if [[ ! -e "$config_file" && ! -L "$config_file" ]]; then
    local ancestor=$config_dir
    while [[ ! -e "$ancestor" && ! -L "$ancestor" ]]; do
      ancestor=${ancestor%/*}
      [[ -n "$ancestor" ]] || ancestor=/
    done
    config_metadata "$ancestor" directory || return 1
    saved_socket=(absent '' '')
    return 0
  fi
  config_metadata "$config_file" file && config_snapshot "$config_file" || return 1
  [[ "$config_text" != *$'\001'* ]] || has_nul=true
  saved_socket=(unknown '' "unknown config version at $config_file; preserve it for inspection")
  [[ "$config_text" == tailmux-config-v1 || "$config_text" == tailmux-config-v1$'\n'* ]] || return 1
  saved_socket=(malformed '' "malformed current-version data at $config_file; repair with tailmux --config reset socket")
  [[ "$has_nul" == false ]] || return 1
  record=${config_text#*$'\n'}
  [[ "$record" == socket=*$'\n' ]] || return 1
  value=${record#socket=}
  value=${value%$'\n'}
  socket_value_valid "$value" || return 1
  saved_socket=(valid "$value" '')
}

socket_selection() {
  effective_socket='' effective_source='native default' selection_error=''
  if [[ -n ${TAILMUX_TAILSCALE_SOCKET+x} ]]; then
    effective_source=environment
    effective_socket=$TAILMUX_TAILSCALE_SOCKET
    socket_value_valid "$effective_socket" || {
      selection_error='TAILMUX_TAILSCALE_SOCKET must be an absolute path without ASCII control bytes'
      return 1
    }
  else
    case "${saved_socket[0]}" in
      valid) effective_socket=${saved_socket[1]}; effective_source=saved ;;
      absent) ;;
      *) effective_source=saved; selection_error=${saved_socket[2]}; return 1 ;;
    esac
  fi
}

config_cleanup() {
  local status=$?
  trap - EXIT INT TERM
  if [[ -n "$config_stage" ]]; then rm -f "$config_stage" || status=1; fi
  if [[ -n "$config_lock" ]]; then rmdir "$config_lock" || status=1; fi
  exit "$status"
}

config_writer() {
  local directory
  for directory in "$HOME" "$HOME/.config" "$config_dir"; do
    if [[ ! -e "$directory" && ! -L "$directory" ]]; then
      config_metadata "${directory%/*}" directory || fail "invalid-config: unsafe config ancestor $directory" 2
      (umask 077; mkdir "$directory") || [[ -d "$directory" && ! -L "$directory" ]] ||
        fail "invalid-config: cannot create private directory $directory" 2
    fi
    config_metadata "$directory" directory || fail "invalid-config: unsafe config directory $directory" 2
  done
  config_stage='' config_lock=''
  (umask 077; mkdir "$config_dir/.config-lock") || fail "invalid-config: writer locked or cannot acquire $config_dir/.config-lock; inspect it; no automatic unlock" 2
  config_lock=$config_dir/.config-lock
  trap config_cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  config_metadata "$config_lock" directory || fail "invalid-config: cannot verify writer lock $config_lock" 2
}

config_show() {
  local read_status=0 selection_status=0 cli
  config_read || read_status=2
  socket_selection || selection_status=2
  cli=$(command -v tailscale) || cli=unavailable
  printf 'Config file: %s\nSaved socket: %s\nSaved state: %s\n' "$config_file" "${saved_socket[1]:-unset}" "${saved_socket[0]}"
  if [[ $selection_status == 0 ]]; then
    printf 'Effective socket: %s\n' "${effective_socket:-Tailscale CLI default endpoint}"
  else
    printf 'Effective socket: invalid (%s)\n' "$selection_error"
  fi
  printf 'Source: %s\nPATH-selected CLI: %s\n' "$effective_source" "$cli"
  if [[ "$effective_source" == environment ]]; then printf '%s\n' 'Environment overrides saved configuration, including after reset.'; fi
  if [[ $read_status != 0 ]]; then printf '%s\n' "${saved_socket[2]}" >&2; fi
  [[ $read_status == 0 && $selection_status == 0 ]]
}

config_command() {
  local action=${2:-} value=${4:-} backup
  case "$action" in
    show) [[ $# == 2 ]] || fail 'invalid-request: use --config show' 2 ;;
    set) [[ $# == 4 && "$3" == socket ]] || fail 'invalid-request: use --config set socket PATH' 2
      if ! socket_value_valid "$value" || (( ${#value} + 26 > 8192 )); then
        fail 'invalid-config: socket must be an absolute path without ASCII controls and fit the 8 KiB config limit' 2
      fi ;;
    reset) [[ $# == 3 && "$3" == socket ]] || fail 'invalid-request: use --config reset socket' 2 ;;
    *) fail 'invalid-request: use --config show, --config set socket PATH, or --config reset socket' 2 ;;
  esac
  config_location
  if [[ "$action" == show ]]; then config_show || exit 2; return; fi
  config_writer
  config_read || :
  case "${saved_socket[0]}" in
    absent|valid) ;;
    malformed) [[ "$action" == reset ]] || fail "invalid-config: ${saved_socket[2]}" 2 ;;
    *) fail "invalid-config: ${saved_socket[2]}" 2 ;;
  esac
  if [[ "$action" == set ]]; then
    config_stage=$(umask 077; mktemp "$config_dir/.config-stage.XXXXXXXX") || fail "invalid-config: cannot stage $config_file" 2
    [[ -n "$config_stage" && "$config_stage" == "$config_dir/.config-stage."* ]] || fail "invalid-config: invalid staging path for $config_file" 2
    config_metadata "$config_stage" file || fail "invalid-config: unsafe stage $config_stage" 2
    printf 'tailmux-config-v1\nsocket=%s\n' "$value" > "$config_stage" || fail "invalid-config: cannot write $config_stage" 2
    if ! config_metadata "$config_stage" file || ! config_snapshot "$config_stage" ||
      [[ "$config_text" != tailmux-config-v1$'\nsocket='"$value"$'\n' ]]; then
      fail "invalid-config: cannot verify $config_stage" 2
    fi
    mv -f "$config_stage" "$config_file" || fail "invalid-config: cannot publish $config_file" 2
    if ! config_read || [[ "${saved_socket[1]}" != "$value" || -e "$config_stage" || -L "$config_stage" ]]; then
      fail "invalid-config: cannot verify published $config_file" 2
    fi
    config_stage=''
    printf 'Saved socket: %s\n' "$value"
  else
    if [[ "${saved_socket[0]}" != absent ]]; then
      backup=$(umask 077; mktemp "$config_dir/config.backup.XXXXXXXX") || fail "invalid-config: cannot create backup for $config_file" 2
      [[ -n "$backup" && "$backup" == "$config_dir/config.backup."* ]] || fail "invalid-config: invalid backup path for $config_file" 2
      config_metadata "$backup" file || fail "invalid-config: unsafe backup $backup; preserved $config_file" 2
      if ! head -c 8193 < "$config_file" > "$backup" || ! config_metadata "$backup" file ||
        ! cmp -s "$config_file" "$backup"; then
        fail "invalid-config: cannot verify backup $backup; preserved $config_file" 2
      fi
      if ! rm "$config_file" || [[ -e "$config_file" || -L "$config_file" ]]; then
        fail "invalid-config: cannot clear $config_file; backup $backup" 2
      fi
      printf 'Content backup: %s\n' "$backup"
    fi
    printf '%s\n' 'Saved socket: unset'
    if [[ -n ${TAILMUX_TAILSCALE_SOCKET+x} ]]; then printf '%s\n' 'Environment override remains; unset TAILMUX_TAILSCALE_SOCKET to use the native default.'; fi
  fi
}

mode=connect
selector=''
user=''
case "${1:-}" in
  --help|-h) [[ $# == 1 ]] || fail 'invalid-request: help takes no arguments' 2; usage; exit 0 ;;
  --version|-V) [[ $# == 1 ]] || fail 'invalid-request: version takes no arguments' 2; printf 'tailmux %s\n' "$TAILMUX_VERSION"; exit 0 ;;
  --config) mode=config; config_command "$@"; exit 0 ;;
  doctor) mode=doctor; shift ;;
esac
if [[ "$mode" == connect && $# != 1 || "$mode" == doctor && $# -gt 1 ]]; then
  usage >&2
  fail 'invalid-request: exactly one selector is required for connect' 2
fi
if [[ $# == 1 ]]; then
  selector=$1
  if [[ "$selector" == *@* ]]; then
    user=${selector%%@*}
    selector=${selector#*@}
    [[ "$user" =~ ^[A-Za-z_][A-Za-z0-9_-]{0,31}\$?$ ]] || fail 'invalid-request: invalid remote user' 2
  fi
  [[ -n "$selector" && "$selector" != -* && "$selector" != *[!A-Za-z0-9.:_-]* ]] || fail 'invalid-request: invalid selector' 2
fi

saved_socket=(absent '' '')
if [[ -z ${TAILMUX_TAILSCALE_SOCKET+x} ]]; then
  config_location
  config_read || fail "invalid-config: ${saved_socket[2]}" 2
fi
socket_selection || fail "invalid-config: $selection_error" 2
readonly effective_socket effective_source
if [[ "$effective_source" != 'native default' ]]; then
  readonly -a tailscale_cmd=(tailscale "--socket=$effective_socket")
  readonly tailscale_endpoint="socket $effective_socket; source $effective_source; daemon executable unknown"
  readonly tailscale_context=" (socket $effective_socket; source $effective_source)"
else
  readonly -a tailscale_cmd=(tailscale)
  readonly tailscale_endpoint='Tailscale CLI default endpoint; daemon executable unknown'
  readonly tailscale_context=''
fi

doctor_probe() {
  local output probe_status
  output=$(
    if [[ "$1" == ssh ]]; then "$@" 2>&1; else "$@" 2>/dev/null; fi |
      head -c 65537 | tr '\000' '\001'
    probe_status=$?
    printf '\002'
    exit "$probe_status"
  ) || return 1
  output=${output%$'\002'}
  [[ ${#output} -le 65536 ]] || return 1
  printf '%s' "$output"
}

doctor_row() {
  local field separator=''
  for field in "$@"; do
    field=${field//[^[:print:]]/?}
    printf '%s%s' "$separator" "$field"
    separator=$'\t'
  done
  printf '\n'
}

doctor_policy() {
  local name=$1 version=$2 baseline='' component version_baseline a b c x y z
  while IFS='|' read -r component version_baseline; do
    [[ "$component" != "$name" ]] || baseline=$version_baseline
  done <<'POLICY'
tailscale|1.104.2
jq|1.8.2
POLICY
  local version_pattern='^(0|[1-9][0-9]{0,3})\.(0|[1-9][0-9]{0,3})\.(0|[1-9][0-9]{0,3})(-t[0-9a-f]{6,40}(-g[0-9a-f]{6,40})?)?$'
  if [[ ! "$version" =~ $version_pattern ]]; then
    printf '%s' 'unknown|missing, unparseable, development, or vendor build; patch evidence required'
    return
  fi
  version=${version%%-*}
  IFS=. read -r a b c <<< "$version"
  IFS=. read -r x y z <<< "$baseline"
  if [[ "$name" == tailscale ]] && (( 10#$b % 2 != 0 )); then
    printf '%s' 'unsupported|unstable Tailscale branch is outside reviewed policy'
  elif [[ "$version" == "$baseline" ]]; then
    printf 'supported|matches reviewed %s version baseline; build provenance and platform compatibility unverified' "$baseline"
  elif (( 10#$a < 10#$x || (10#$a == 10#$x && 10#$b < 10#$y) || (10#$a == 10#$x && 10#$b == 10#$y && 10#$c < 10#$z) )); then
    if [[ "$name" == tailscale && "$a" == 1 ]]; then
      printf '%s' 'advisory-affected|below 1.104.2 policy floor; conditional TS-2026-013 if compromised certificates remain trusted; exposure unverified'
      if (( 10#$b < 102 || (10#$b == 102 && 10#$c < 3) )); then
        printf '%s' '; TS-2026-011 if advertising affected 4via6 routes'
      fi
      if (( 10#$b < 102 || (10#$b == 102 && 10#$c < 1) )); then
        printf '%s' '; TS-2026-010 if SSH acceptEnv forwards secrets'
      fi
      if (( 10#$b < 98 || (10#$b == 98 && 10#$c < 9) )); then
        printf '%s' '; TS-2026-009/006 if affected SSH server enforces nonroot restrictions; TS-2026-005 if affected Serve operator proxies privileged sockets'
      fi
    else
      printf 'unsupported|below reviewed %s version baseline; no vulnerability conclusion' "$baseline"
    fi
  else
    printf '%s' 'unknown|newer than dated reviewed baseline; human policy refresh required'
  fi
}

if [[ "$mode" == doctor && -z "$selector" ]]; then
  printf 'tailmux %s\nPolicy evidence date 2026-10-22. Version policy is separate from platform compatibility.\n' "$TAILMUX_VERSION"
  printf 'Read-only local inventory. No remote tmux, trust-store, or vendor-patch verification.\n'
  printf 'name\trole/owner\tactive path\tCLI version\tdaemon version\tpolicy classification\tevidence date\treason\n'
  policy=supported
  if (( BASH_VERSINFO[0] < 3 || (BASH_VERSINFO[0] == 3 && BASH_VERSINFO[1] < 2) )); then policy=unsupported; fi
  doctor_row Bash 'runtime interpreter / OS owner' "$BASH" "$BASH_VERSION" - "$policy" 2026-10-22 'Bash 3.2 language baseline accepted; OS security maintenance unknown'
  jq_path=$(command -v jq || :)
  ts_path=$(command -v tailscale || :)
  ssh_path=$(command -v ssh || :)
  head_path=$(command -v head || :)
  jq_version=unknown
  if [[ -n "$jq_path" && -n "$head_path" ]]; then
    raw=$(doctor_probe jq --version) || raw=''
    [[ "$raw" =~ ^jq-([0-9]+\.[0-9]+\.[0-9]+)$ ]] && jq_version=${BASH_REMATCH[1]}
  fi
  IFS='|' read -r policy reason <<< "$(doctor_policy jq "$jq_version")"
  if [[ -z "$jq_path" ]]; then policy=unsupported; reason='required jq executable missing'; fi
  doctor_row jq 'JSON parser / package owner' "${jq_path:-unavailable}" "$jq_version" - "$policy" 2026-10-22 "$reason"
  cli=unknown daemon=unknown build=unknown
  if [[ -n "$ts_path" && -n "$jq_path" && -n "$head_path" ]]; then
    daemon_read=true
    if ! raw=$(doctor_probe "${tailscale_cmd[@]}" version --daemon --json); then
      daemon_read=false
      raw=$(doctor_probe "${tailscale_cmd[@]}" version --json) || raw=''
    fi
    parsed=$(printf '%s' "$raw" | jq -ers '
      def version: type == "string" and length <= 128 and test("\\A[0-9][A-Za-z0-9.+_-]*\\z");
      if length != 1 then error("documents") else .[0] end |
      if type != "object" or (.long | version | not) or
        (.short | version | not) or (.majorMinorPatch | version | not) or
        ((.long | split("-")[0]) != .majorMinorPatch) or
        ((.short | split("-")[0]) != .majorMinorPatch) or
        (has("daemonLong") and (.daemonLong | version | not)) or
        any([.isDev, .gitDirty, .unstableBranch][]; . != null and type != "boolean")
      then error("schema") else . end |
      [.long, (.daemonLong // "unknown"),
       (if .isDev == true or .gitDirty == true or .unstableBranch == true then "unreviewed" else "release" end)] | join("|")
    ' 2>/dev/null) || parsed='unknown|unknown|unknown'
    IFS='|' read -r cli daemon build <<< "$parsed"
    [[ "$daemon_read" == true ]] || daemon=unknown
  fi
  mismatch='CLI/daemon comparison unknown'
  if [[ "$cli" != unknown && "$daemon" != unknown ]]; then
    mismatch='CLI/daemon versions match'
    [[ "$cli" == "$daemon" ]] || mismatch='CLI/daemon mismatch; package owner must verify active daemon; no restart performed'
  fi
  for component in CLI daemon; do
    version=$cli active_path=${ts_path:-unavailable}
    if [[ "$component" == daemon ]]; then version=$daemon; active_path=$tailscale_endpoint; fi
    IFS='|' read -r policy reason <<< "$(doctor_policy tailscale "$version")"
    if [[ "$component" == CLI && "$build" == unreviewed ]]; then policy=unknown; reason='development, dirty, or unstable CLI build; vendor patch evidence required'; fi
    if [[ -z "$ts_path" ]]; then policy=unsupported; reason='required Tailscale executable missing'; fi
    doctor_row "Tailscale $component" 'transport / Tailscale package owner' "$active_path" "$cli" "$daemon" "$policy" 2026-10-22 "$reason; $mismatch; multiple installations can select different daemons; configure TAILMUX_TAILSCALE_SOCKET; version agreement does not establish the selected installation"
  done
  ssh_version=unknown
  if [[ -n "$ssh_path" && -n "$head_path" ]]; then
    raw=$(doctor_probe ssh -V) || raw=''
    [[ "$raw" =~ ^(OpenSSH[_][0-9]+\.[0-9]+p?[0-9]*)[[:space:],] ]] && ssh_version=${BASH_REMATCH[1]}
  fi
  policy=unknown reason='vendor patch and OS build evidence required; banner alone cannot establish CVE applicability'
  if [[ -z "$ssh_path" ]]; then policy=unsupported; reason='required OpenSSH executable missing'; fi
  doctor_row OpenSSH 'SSH client / OS or package owner' "${ssh_path:-unavailable}" "$ssh_version" - "$policy" 2026-10-22 "$reason"
  doctor_row tmux 'remote session / destination operator' 'unknown (remote-owned)' unknown - unknown 2026-10-22 'local tmux is irrelevant; no remote command executed'
  doctor_row 'TLS trust' 'OS certificates and bundled Go / OS and Tailscale owners' 'unknown (not inspected)' unknown unknown unknown 2026-10-22 'system Go upgrades do not patch bundled Tailscale Go; trust-store exposure unverified'
  exit 0
fi
for dependency in jq tailscale ssh mktemp head wc tr rm rmdir; do
  command -v "$dependency" >/dev/null 2>&1 || fail "missing-dependency: $dependency"
done

work=$(mktemp -d "${TMPDIR:-/tmp}/tailmux.XXXXXXXX") || fail 'local-io: cannot create private snapshot directory'
trap 'rm -f "$work/status" "$work/aliases"; rmdir "$work"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
hosts=${TAILMUX_HOSTS_FILE-"${HOME:-}/.config/tailmux/hosts"}
if [[ -n ${TAILMUX_HOSTS_FILE+x} && ! -f "$hosts" ]]; then
  fail 'invalid-aliases: explicitly selected hosts file is missing or not regular'
fi
if [[ -e "$hosts" ]]; then
  [[ -f "$hosts" && -r "$hosts" ]] || fail 'invalid-aliases: hosts file is not readable regular data'
  head -c 65537 < "$hosts" > "$work/aliases" || fail 'invalid-aliases: cannot read hosts file'
else
  : > "$work/aliases"
fi
[[ $(wc -c < "$work/aliases") -le 65536 ]] || fail 'invalid-aliases: hosts file exceeds 64 KiB'
[[ $(wc -c < "$work/aliases") == $(tr -d '\000' < "$work/aliases" | wc -c) ]] || fail 'invalid-aliases: NUL byte in hosts file'

"${tailscale_cmd[@]}" status --json 2>/dev/null | head -c 8388609 > "$work/status"
pipeline_status=("${PIPESTATUS[@]}")
[[ $(wc -c < "$work/status") -le 8388608 ]] || fail 'invalid-schema: status exceeds 8 MiB'
[[ ${pipeline_status[0]} == 0 && ${pipeline_status[1]} == 0 ]] || fail "daemon-unavailable: tailscale status failed${tailscale_context}"
[[ $(wc -c < "$work/status") == $(tr -d '\000' < "$work/status" | wc -c) ]] || fail 'invalid-schema: NUL byte in status'

result=$(jq -cs --arg mode "$mode" --arg selector "$selector" --arg user "$user" --rawfile aliases "$work/aliases" '
  def bad($code): error($code);
  def dns:
    if type != "string" then false else length <= 254 and
    (ascii_downcase | rtrimstr(".") | split(".") |
      length > 0 and all(.[]; length <= 63 and test("\\A[a-z0-9]([a-z0-9-]*[a-z0-9])?\\z"))) end;
  def canonical: ascii_downcase | rtrimstr(".");
  def ipv4:
    if type != "string" then false else (split(".") | length == 4 and
      all(.[]; test("\\A(0|[1-9][0-9]{0,2})\\z") and (try (tonumber <= 255) catch false))) end;
  def ipv6:
    if type != "string" then false else test("\\A[0-9a-fA-F:]+\\z") and contains(":") and
    (split("::") | if length == 1 then
      (.[0] | split(":") | length == 8 and all(.[]; test("\\A[0-9a-fA-F]{1,4}\\z")))
    elif length == 2 then
      ([.[] | select(length > 0) | split(":")[]] |
        length < 8 and all(.[]; test("\\A[0-9a-fA-F]{1,4}\\z")))
    else false end) end;
  def address: ipv4 or ipv6;
  def fqdn: dns and (canonical | contains(".")) and (ipv4 | not);
  def key:
    type == "string" and length <= 16384 and
    test("\\A(ssh-(ed25519|rsa)|ecdsa-sha2-nistp(256|384|521)|sk-ssh-ed25519@openssh.com|sk-ecdsa-sha2-nistp256@openssh.com) [A-Za-z0-9+/]{4,}={0,2}( [ -~]*)?\\z") and
    (split(" ")[1] | length % 4 == 0);
  def aliases:
    $aliases | split("\n") | map(gsub("\\A[ \\t]+|[ \\t\\r]+\\z"; "")) |
    map(select(length > 0 and (startswith("#") | not)) | [scan("[^ \\t]+")]) |
    if length > 256 or any(.[]; length != 2) then bad("invalid-aliases") else . end |
    map(if (.[0] | dns and (canonical | contains(".") | not)) and (.[1] | fqdn or address)
      then {name:(.[0]|canonical), target:(.[1]|canonical)} else bad("invalid-aliases") end) |
    if (map(.name)|unique|length) != length then bad("invalid-aliases") else . end;
  def peer:
    if type != "object" or (.ID | type != "string") or (.ID | test("\\A[A-Za-z0-9_-]{1,128}\\z") | not) or
      (.DNSName | type != "string") or (.DNSName != "" and (.DNSName | fqdn | not)) or
      (.TailscaleIPs | type != "array") or (.TailscaleIPs | length > 64) or
      (.TailscaleIPs | all(.[]; address) | not) or (.InNetworkMap | type != "boolean") or
      (has("Online") and .Online != null and (.Online | type != "boolean")) or
      (has("Expired") and (.Expired | type != "boolean")) or
      (has("sshHostKeys") and .sshHostKeys != null and
        ((.sshHostKeys | type != "array") or (.sshHostKeys | length > 64) or (.sshHostKeys | all(.[]; key) | not)))
    then bad("invalid-schema") else
      {id:.ID, dns:(.DNSName|canonical), addresses:(.TailscaleIPs | map(ascii_downcase)),
       sshHostKeys:(.sshHostKeys // []), inNetworkMap:.InNetworkMap,
       online:(if has("Online") then .Online else null end),
       expired:(if has("Expired") then .Expired else false end)}
    end;
  try (
    if length != 1 then bad("invalid-schema") else .[0] end |
    if type != "object" or (.BackendState | type != "string") then bad("invalid-schema") else . end |
    if .BackendState == "NeedsLogin" then bad("logged-out")
    elif .BackendState == "Stopped" then bad("stopped/not-ready")
    elif (.BackendState as $state | ["NoState", "NeedsMachineAuth", "Starting", "InUseOtherUser"] | index($state)) != null then bad("stopped/not-ready")
    elif .BackendState != "Running" then bad("invalid-schema") else . end |
    if (has("Peer") | not) or (.Peer != null and (.Peer | type != "object")) or
      (has("CurrentTailnet") and .CurrentTailnet != null and (.CurrentTailnet | type != "object")) or
      (.CurrentTailnet != null and (.CurrentTailnet|has("MagicDNSSuffix")) and
       (.CurrentTailnet.MagicDNSSuffix | type != "string")) then bad("invalid-schema") else . end |
    {backend:.BackendState,
     suffix:(if (.CurrentTailnet.MagicDNSSuffix | fqdn) then (.CurrentTailnet.MagicDNSSuffix|canonical) else null end),
     peers:((.Peer // {}) | if length > 4096 then bad("invalid-schema") else [.[]|peer] end)} as $snapshot |
    if ($snapshot.peers|map(.id)|unique|length) != ($snapshot.peers|length) then bad("invalid-schema") else . end |
    {mode:$mode, selector:($selector|canonical), user:(if $user == "" then null else $user end),
     transport:"tailscale-ssh", session:"attach-any"} as $request |
    if ($request.selector | dns or address | not) then bad("invalid-request") else . end |
    aliases as $aliases |
    ([$aliases[]|select(.name == $request.selector)] |
      if length == 1 then .[0].target else $request.selector end) as $selected |
    [$snapshot.peers[] | select(.inNetworkMap and .dns != "" and (.addresses|length > 0)) |
      select(.dns == $selected or (.addresses | index($selected)) != null or
        ($snapshot.suffix != null and ($selected|contains(".") or contains(":") | not) and
          .dns == ($selected + "." + $snapshot.suffix)))] as $matches |
    (if ($matches|length) == 0 then bad("unknown-selector")
    elif ($matches|length) != 1 then bad("ambiguous-selector") else $matches[0] end) as $peer |
    if any($snapshot.peers[]; .id != $peer.id and
      (.dns == $peer.dns or any(.addresses[]; . as $ip | $peer.addresses | index($ip) != null)))
      then bad("ambiguous-selector") else . end |
    if $peer.expired then bad("peer-key-expired")
    elif ($peer.sshHostKeys|length) == 0 then bad("missing-advertised-host-keys") else . end |
    {ok:true, target:{peerId:$peer.id, canonicalDNS:$peer.dns,
      address:(if ($peer.addresses|index($selected)) != null then $selected
        else ($peer.addresses|sort_by([if contains(":") then 1 else 0 end, .])|.[0]) end),
      user:$request.user, online:$peer.online, expired:$peer.expired,
      transport:$request.transport, session:$request.session}}
  ) catch {ok:false, error:(if . == "invalid-aliases" or . == "invalid-request" or
    . == "logged-out" or . == "stopped/not-ready" or . == "unknown-selector" or
    . == "ambiguous-selector" or . == "peer-key-expired" or . == "missing-advertised-host-keys"
    then . else "invalid-schema" end)}
' "$work/status" 2>/dev/null) || fail 'invalid-schema: status is not exactly one valid JSON document'
if [[ $(printf '%s' "$result" | jq -r '.ok') != true ]]; then
  error=$(printf '%s' "$result" | jq -r '.error')
  case "$error" in
    logged-out|stopped/not-ready) error+=$tailscale_context ;;
  esac
  fail "$error"
fi
if [[ "$mode" == doctor ]]; then
  printf '%s\n' "$result" | jq .target
  exit 0
fi
destination=$(printf '%s' "$result" | jq -r '.target | (if .user == null then "" else .user + "@" end) + .address') || exit 1
if ! rm -f "$work/status" "$work/aliases" || ! rmdir "$work"; then fail 'local-io: snapshot cleanup failed'; fi
trap - EXIT INT TERM
readonly remote_program='if command -v tmux >/dev/null 2>&1; then tmux attach || tmux new; else printf "%s\n" "tmux not found on remote" >&2; exit 127; fi'
exec "${tailscale_cmd[@]}" ssh "$destination" -t "$remote_program"
